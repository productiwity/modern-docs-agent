{
  "html": "<main class=\"brief\"><h1>Illustrative orders</h1><nav><a class=\"baseline\" href=\"#01J00000000000000000000001\">Baseline</a> <a class=\"upside\" href=\"#01J00000000000000000000001\">Upside</a></nav><section data-md-id=\"01J00000000000000000000001\"><h2 class=\"scenario\">Baseline</h2><div class=\"chart\"><div><div class=\"plot\"><div class=\"bar first\"></div></div><p>Monday: 20</p></div><div><div class=\"plot\"><div class=\"bar second\"></div></div><p class=\"second-label\">Tuesday: 40</p></div></div><p>Zero baseline. Shared maximum: 50 orders.</p><cite>Fictional planning data</cite></section></main>",
  "css": ".brief{max-width:800px;margin:0 auto;padding:32px;color:#172b3a;background:#fffdf6}section{scroll-margin-top:24px}.chart{display:flex;gap:24px}.plot{height:200px;display:flex;align-items:flex-end}.bar{width:60px;flex-shrink:0;background:#245c43}.first{height:40%}.second{height:80%}.chart.upside-active .second{height:100%}a:focus-visible{outline:2px solid #245c43}cite{font-size:14px}@media(max-width:480px){.brief{padding:16px}}",
  "javascript": "document.querySelector('.upside').addEventListener('click',(event)=>{event.preventDefault();document.querySelector('.chart').classList.add('upside-active');document.querySelector('.scenario').textContent='Upside';document.querySelector('.second-label').textContent='Tuesday: 50';});document.querySelector('.baseline').addEventListener('click',(event)=>{event.preventDefault();document.querySelector('.chart').classList.remove('upside-active');document.querySelector('.scenario').textContent='Baseline';document.querySelector('.second-label').textContent='Tuesday: 40';});",
  "settings": {}
}
